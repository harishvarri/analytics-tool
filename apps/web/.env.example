# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Ingestion shared secret. Portal SDKs send this as `x-ncpl-api-key`.
# Generate with: openssl rand -base64 32
INGEST_API_KEY=replace-with-32-byte-base64-secret

# Salt for hashing client IPs before storage (rotate to invalidate historical lookups).
IP_HASH_SALT=replace-with-random-string

# Secret stamped on `x-cron-secret` for /api/v1/admin/* maintenance routes.
# Vercel Cron sends this header automatically when configured.
CRON_SECRET=replace-with-32-byte-base64-secret

# Optional
NODE_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=http://localhost:3000
